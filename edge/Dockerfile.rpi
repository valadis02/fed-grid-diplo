FROM python:3.10-slim

WORKDIR /app

COPY edge/requirements.txt /app/

RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    iputils-ping \
    dnsutils \
    iproute2 \
    cmake \
    git \
    && rm -rf /var/lib/apt/lists/*

# Εγκατάσταση όλων εκτός tenseal
RUN pip install --no-cache-dir --default-timeout=1000 \
    $(grep -v tenseal /app/requirements.txt | tr '\n' ' ') pika

# Compile tenseal v0.3.15 από source για arm64
RUN git clone https://github.com/OpenMined/TenSEAL.git /tmp/tenseal \
    && cd /tmp/tenseal \
    && git checkout v0.3.15 \
    && git submodule update --init --recursive \
    && pip install --no-cache-dir . \
    && rm -rf /tmp/tenseal

COPY edge /app/edge
COPY shared /app/shared
COPY federated_topology.json /app/

RUN mkdir -p /app/models /app/edge/models /app/data/filtered_data

ENV PYTHONPATH=/app

CMD ["python3", "-m", "edge.model.run_federated_cycle"]